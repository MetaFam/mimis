{
	"name": "gremlin-mimis",
	"private": true,
	"version": "0.2.1",
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"site:build": "vite build",
		"build": "pnpm run editor:build && pnpm run site:build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint .",
		"editor:build": "pnpm --dir editor install && pnpm --dir editor build",
		"gh:publish": "gh-pages --dist build/ --nojekyll --message '¡Go forth, young program, & be fruitful! 🫐'",
		"gh:help": "gh-pages --help",
		"deploy": "pnpm run build && wrangler pages deploy",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright install && playwright test --pass-with-no-tests",
		"cf-typegen": "wrangler types src/worker-configuration.d.ts"
	},
	"dependencies": {
		"@ipld/dag-cbor": "^9.2.5",
		"@reown/appkit": "^1.8.17",
		"@reown/appkit-adapter-wagmi": "^1.8.17",
		"@reown/appkit-wallet-button": "^1.8.17",
		"@wagmi/core": "^3.3.4",
		"force-graph": "^1.51.4",
		"gh-pages": "^6.3.0",
		"gremlin": "3.7.3",
		"ignore": "^7.0.5",
		"ipfs-car": "^3.1.0",
		"kubo-rpc-client": "^6.0.2",
		"multiformats": "^13.4.2",
		"uuid": "^13.0.0",
		"valibot": "^1.2.0",
		"viem": "^2.45.1",
		"wagmi": "^3.4.2"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-cloudflare": "^8.0.0",
		"@sveltejs/adapter-node": "^5.4.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/gremlin": "^3.6.7",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^4.1.8",
		"eslint": "^10.4.1",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"playwright": "^1.60.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1",
		"wrangler": "^4.97.0"
	}
}
